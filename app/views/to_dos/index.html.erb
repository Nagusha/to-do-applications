<h1 style="text-align: center;">📝 ToDo List</h1>

<!-- Add Form -->
<div style="text-align: center; margin-bottom: 30px;">
  <%= form_with model: @to_do, url: to_dos_path, local: true do |form| %>
    <%= form.text_field :title, placeholder: "Enter a new task...", required: true,
        style: "padding: 10px; width: 60%; margin-right: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);" %>
    <%= form.submit "Add", style: "padding: 10px 20px; background-color: green; color: white; border: none; box-shadow: 0 2px 5px rgba(0,0,0,0.2);" %>
  <% end %>
</div>

<!-- ToDo List -->
<ul style="list-style: none; padding: 0; max-width: 600px; margin: auto;">
  <% @to_dos.each do |todo| %>
    <li style="
      background-color: <%= todo.completed ? '#d4edda' : '#ffffff' %>;
      text-decoration: <%= todo.completed ? 'line-through' : 'none' %>;
      padding: 15px;
      margin-bottom: 15px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 18px;
      cursor: pointer;
      position: relative;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);"
      onclick="document.getElementById('toggle_<%= todo.id %>').submit();">

      <%= todo.title %>

      <!-- Hidden toggle form -->
      <%= form_with url: toggle_to_do_path(todo), method: :patch, local: true, id: "toggle_#{todo.id}", style: "display: none;" do %>
      <% end %>

      <!-- Delete button -->
      <%= button_to "🗑️", to_do_path(todo), method: :delete, data: { confirm: "Are you sure?" },
          style: "position: absolute; right: 15px; top: 50%; transform: translateY(-50%);
                  background: none; border: none; color: red; font-size: 20px; cursor: pointer;" %>
    </li>
  <% end %>
</ul>

<!-- Count Summary -->
<div style="text-align: center; margin-top: 30px; font-size: 16px;">
  <span style="background-color: green; color: white; padding: 5px 10px; border-radius: 5px; margin-right: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
    Total: <strong><%= @total_count %></strong>
  </span>
  <span style="background-color: green; color: white; padding: 5px 10px; border-radius: 5px; margin-right: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
    Marked: <strong><%= @completed_count %></strong>
  </span>
  <span style="background-color: green; color: white; padding: 5px 10px; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
    Unmarked: <strong><%= @uncompleted_count %></strong>
  </span>
</div>
